{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.json"],
  "options": {
    "typeAware": false
  },
  "ignorePatterns": [
    "**/lib/**",
    "**/node_modules/**",
    "**/.sessions/**",
    ".claude/**",
    "**/.doc-typecheck-*/**",
    "**/.node-next-types-*/**",
    "website/.generated/**",
    "vendor/**",
    // Imported community implementations retain their original lint scope; integration code is checked separately.
    "packages/deepseek-harness-product/experts/src/**",
    "packages/deepseek-harness-product/skills/src/**",
    "!packages/deepseek-harness-product/experts/src/settings.ts",
    "!packages/deepseek-harness-product/experts/src/remote-contract.ts",
    "!packages/deepseek-harness-product/experts/src/client/remote.ts",
    "!packages/deepseek-harness-product/experts/src/types.ts",
    "!packages/deepseek-harness-product/experts/src/creation*.ts",
    "!packages/deepseek-harness-product/experts/src/client/creation-card.tsx",
    "!packages/deepseek-harness-product/experts/tests/client/creation-card.test.tsx",
    "!packages/deepseek-harness-product/experts/src/client/bulk-operations*.ts",
    "!packages/deepseek-harness-product/experts/src/client/client-state*.ts",
    "!packages/deepseek-harness-product/experts/src/client/catalog.ts",
    "!packages/deepseek-harness-product/experts/src/client/team-cache.ts",
    "!packages/deepseek-harness-product/skills/src/submission.ts",
    "!packages/deepseek-harness-product/skills/src/skill-body.ts",
    "!packages/deepseek-harness-product/skills/src/native-*.test.ts",
    "!packages/deepseek-harness-product/skills/src/manager.ts",
    "!packages/deepseek-harness-product/skills/src/host-runtime.ts",
    "!packages/deepseek-harness-product/skills/src/log.ts",
    "!packages/deepseek-harness-product/skills/src/remote-client.ts",
    "!packages/deepseek-harness-product/skills/src/skill-document.ts",
    "!packages/deepseek-harness-product/skills/src/response-bytes.ts",
    "native/**",
    "**/*.js",
    "**/*.mjs",
    "**/*.config.ts",
    "packages/client/tsdown.client.ts"
  ]
}
