{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "windows": {
      "digestAlgorithm": "sha256",
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "& $env:XIAOYIN_SIGN_SCRIPT_PATH '%1'"
        ]
      }
    }
  }
}
