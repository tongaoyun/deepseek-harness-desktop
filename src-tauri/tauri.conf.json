{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小胤",
  "version": "0.1.0",
  "identifier": "com.instudio.xiaoyin.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "小胤",
        "width": 1320,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      },
      {
        "label": "erp-login",
        "url": "index.html?window=erp-login",
        "title": "小胤 · ERP 扫码登录",
        "width": 420,
        "height": 540,
        "minWidth": 380,
        "minHeight": 500,
        "center": true,
        "visible": false,
        "focus": false,
        "resizable": false,
        "fullscreen": false,
        "closable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8080 http://192.168.2.67:32000; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  }
}
