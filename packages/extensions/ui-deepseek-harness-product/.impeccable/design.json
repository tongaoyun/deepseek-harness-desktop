      "html": "<button class=\"ds-button-primary\">New personal knowledge base</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:4px;border:0;cursor:pointer;font-family:var(--dsw-font-family);height:36px;padding:0 14px;border-radius:var(--dsw-radius-md);font-size:14px;line-height:22px;color:var(--dsw-alias-label-primary-foreground);background:var(--dsw-alias-button-primary-fill);}@media(hover:hover){.ds-button-primary:hover:not(:disabled){background:var(--dsw-alias-button-primary-hover);}}.ds-button-primary:focus-visible{outline-color:var(--dsw-alias-state-business-primary);outline-width:2px;}.ds-button-primary:disabled{opacity:.4;cursor:not-allowed;}"
