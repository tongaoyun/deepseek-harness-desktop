      "kind": "input",
      "refersTo": "search-field",
      "description": "Labeled search wrapper shared by directory and materials.",
      "html": "<label class=\"ds-search\"><svg width=\"16\" height=\"16\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\" fill=\"none\" stroke-width=\"1\"><path d=\"M6.58727 11.8586C9.55061 11.8586 11.9529 9.45637 11.9529 6.49304C11.9529 3.5297 9.55061 1.12744 6.58727 1.12744C3.62394 1.12744 1.22168 3.5297 1.22168 6.49304C1.22168 9.45637 3.62394 11.8586 6.58727 11.8586Z\" stroke=\"currentColor\"></path><path d=\"M10.2991 10.3933L14.7783 14.8725\" stroke=\"currentColor\"></path></svg><input type=\"search\" aria-label=\"Search knowledge bases\" placeholder=\"Search knowledge bases…\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:8px;width:min(280px,100%);height:34px;padding:0 10px;border:.5px solid var(--dsw-alias-border-l2);border-radius:7px;background:var(--dsw-alias-bg-base);color:var(--dsw-alias-label-tertiary);}.ds-search input{flex:1;min-width:0;height:100%;padding:0;border:0;outline:0;background:transparent;color:var(--dsw-alias-label-primary);font:13px/20px var(--dsw-font-family);}.ds-search input::placeholder{color:var(--dsw-alias-label-tertiary);}.ds-search:focus-within{border-color:var(--dsw-alias-border-l4);color:var(--dsw-alias-label-secondary);}"
    },
    {
      "name": "Scope tabs",
      "kind": "nav",
      "description": "Native SegmentedControl geometry and selected state; runtime keyboard behavior remains native.",
      "html": "<div class=\"ds-scopes\" role=\"tablist\" aria-label=\"Knowledge base scope\"><span aria-hidden=\"true\" class=\"ds-scope-indicator\"></span><button type=\"button\" role=\"tab\" aria-selected=\"true\" tabindex=\"0\">All</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Personal</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Department</button><button type=\"button\" role=\"tab\" aria-selected=\"false\" tabindex=\"-1\">Company</button></div>",
      "css": ".ds-scopes{--dsh-segment-count:4;--dsh-segment-index:0;position:relative;display:inline-grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);gap:2px;padding:4px;border-radius:var(--dsw-radius-md);background:var(--dsw-alias-interactive-bg-hover);}.ds-scope-indicator{position:absolute;top:4px;left:4px;width:calc((100% - 8px - 2px * (var(--dsh-segment-count) - 1)) / var(--dsh-segment-count));height:calc(100% - 8px);border:0;border-radius:var(--dsw-radius-sm);background:var(--dsw-alias-bg-layer-1);box-shadow:var(--dsw-elevation-soft);transform:translateX(calc(var(--dsh-segment-index) * (100% + 2px)));transition:transform 160ms ease;pointer-events:none;}.ds-scopes button{position:relative;z-index:1;height:28px;padding:0 16px;border:0;border-radius:var(--dsw-radius-sm);background:transparent;color:var(--dsw-alias-label-secondary);font:500 13px/20px var(--dsw-font-family);white-space:nowrap;cursor:pointer;transition:color 120ms ease;}.ds-scopes button[aria-selected=\"true\"]{color:var(--dsw-alias-label-primary);}@media(hover:hover){.ds-scopes button:hover:not(:disabled){color:var(--dsw-alias-label-primary);}}.ds-scopes button:disabled{cursor:default;opacity:.4;}.ds-scopes button:focus-visible{outline:var(--dsw-focus-ring-width) solid var(--dsw-focus-ring-color,var(--dsw-alias-state-business-primary));outline-offset:-2px;}@media(prefers-reduced-motion:reduce){.ds-scope-indicator,.ds-scopes button{transition:none;}}"
    },
    {
      "name": "Library card",
      "kind": "card",
      "refersTo": "library-card",
      "description": "Separate open button and scope/owner footer.",
      "html": "<article class=\"ds-library\"><button class=\"ds-library-open\"><span class=\"ds-library-icon\"><svg width=\"23\" height=\"23\" aria-hidden=\"true\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 16 16\" fill=\"none\" stroke-width=\"1\"><path d=\"M13.1967 5.1869C13.7232 4.77378 14.0003 4.30517 14.0001 3.82819C14.0003 3.3512 13.7232 2.88259 13.1967 2.46947C12.6702 2.05635 11.9128 1.71328 11.0006 1.47475C10.0885 1.23621 9.05371 1.11062 8.00039 1.1106C6.94707 1.11057 5.9123 1.23612 5.00009 1.47461C4.08742 1.71301 3.32948 2.05604 2.80249 2.46919C2.2755 2.88235 1.99805 3.35106 1.99805 3.82819C1.99805 4.30531 2.2755 4.77402 2.80249 5.18718C3.32948 5.60033 4.08742 5.94336 5.00009 6.18176C5.9123 6.42025 6.94707 6.5458 8.00039 6.54578C9.05371 6.54575 10.0885 6.42016 11.0006 6.18163C11.9128 5.94309 12.6702 5.60002 13.1967 5.1869Z\" stroke=\"currentColor\"></path><path d=\"M2 3.80371V11.7848\" stroke=\"currentColor\"></path><path d=\"M14 3.80371V11.7848\" stroke=\"currentColor\"></path><path d=\"M2 7.81396C2 8.60524 2.63214 9.36411 3.75736 9.92363C4.88258 10.4832 6.4087 10.7975 8 10.7975C9.5913 10.7975 11.1174 10.4832 12.2426 9.92363C13.3679 9.36411 14 8.60524 14 7.81396\" stroke=\"currentColor\"></path><path d=\"M2 11.7847C2 12.6081 2.63214 13.3977 3.75736 13.98C4.88258 14.5622 6.4087 14.8893 8 14.8893C9.5913 14.8893 11.1174 14.5622 12.2426 13.98C13.3679 13.3977 14 12.6081 14 11.7847\" stroke=\"currentColor\"></path></svg></span><h2>Personal notes</h2><p>Open this library to browse and manage work materials.</p></button><footer>Personal · Library owner</footer></article>",
      "css": ".ds-library{display:flex;width:min(280px,100%);min-width:0;flex-direction:column;border:1px solid var(--dsw-alias-border-l2);border-radius:12px;background:var(--dsw-alias-bg-base);color:var(--dsw-alias-label-primary);overflow:hidden;font-family:var(--dsw-font-family);}.ds-library-open{display:flex;flex:1;flex-direction:column;align-items:flex-start;gap:12px;width:100%;min-width:0;padding:24px 24px 20px;border:0;background:transparent;color:inherit;text-align:left;font:inherit;cursor:pointer;}.ds-library-icon{display:grid;width:42px;height:42px;margin-bottom:4px;place-items:center;border-radius:10px;background:var(--dsw-alias-bg-module-platform);color:var(--dsw-alias-brand-primary);}.ds-library h2{width:100%;margin:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:16px;line-height:24px;font-weight:600;}.ds-library p{display:-webkit-box;min-height:44px;margin:0;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;color:var(--dsw-alias-label-secondary);font-size:13px;line-height:22px;overflow-wrap:anywhere;}.ds-library footer{display:flex;min-height:44px;align-items:center;margin:0 24px;border-top:1px solid var(--dsw-alias-border-l2);color:var(--dsw-alias-label-secondary);font-size:12px;}.ds-library:focus-within{border-color:var(--dsw-alias-border-l4);}.ds-library-open:focus-visible{outline:2px solid var(--dsw-alias-brand-primary);outline-offset:-3px;border-radius:11px;}@media(hover:hover){.ds-library:hover{border-color:var(--dsw-alias-border-l4);}.ds-library-open:hover{background:var(--dsw-alias-interactive-bg-hover);}}"
    },
