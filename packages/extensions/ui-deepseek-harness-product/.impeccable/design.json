      "css": ".ds-button-outline-small{display:inline-flex;align-items:center;justify-content:center;gap:4px;border:0;cursor:pointer;font-family:var(--dsw-font-family);height:28px;padding:0 10px;border-radius:var(--dsw-radius-sm);font-size:12px;line-height:18px;color:var(--dsw-alias-label-primary);background:transparent;}.ds-button-outline-small{border:.5px solid transparent;box-shadow:inset 0 0 0 var(--dsh-hairline-width,.5px) var(--dsh-button-outline-color,var(--dsw-alias-border-l3));}@media(hover:hover){.ds-button-outline-small:hover:not(:disabled){background:var(--dsw-alias-interactive-bg-hover);}}.ds-button-outline-small:focus-visible{outline-color:var(--dsw-alias-state-business-primary);outline-width:2px;}.ds-button-outline-small:disabled{opacity:.4;cursor:not-allowed;}"
