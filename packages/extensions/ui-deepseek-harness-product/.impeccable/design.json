      "css": ".ds-button-ghost-small{display:inline-flex;align-items:center;justify-content:center;gap:4px;border:0;cursor:pointer;font-family:var(--dsw-font-family);height:28px;padding:0 10px;border-radius:var(--dsw-radius-sm);font-size:12px;line-height:18px;color:var(--dsw-alias-label-primary);background:transparent;}@media(hover:hover){.ds-button-ghost-small:hover:not(:disabled){background:var(--dsw-alias-interactive-bg-hover);}}.ds-button-ghost-small:focus-visible{outline-color:var(--dsw-alias-state-business-primary);outline-width:2px;}.ds-button-ghost-small:disabled{opacity:.4;cursor:not-allowed;}.ds-button-ghost-small:active:not(:disabled){background:var(--dsw-alias-interactive-bg-active);}"
