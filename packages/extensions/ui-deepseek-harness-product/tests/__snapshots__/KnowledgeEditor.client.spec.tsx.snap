// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`preserves a conflicting draft when the latest read returns another id 1`] = `"修改文档保存位置知识库 / 知识库首页名称正文My draft正文暂时无法读取，请重试。当前草稿已保留。请对照最新内容调整草稿，确认后再保存。读取最新版本取消保存"`;

exports[`requires a fresh conflict review after a repeated latest read fails with KNOWLEDGE_ACCESS_REVOKED > Pending conflict review 1`] = `
{
  "action": "读取最新版本",
  "busy": "true",
  "draft": "My unsaved changes",
  "focused": true,
  "latest": "Previously reviewed text",
}
`;

exports[`requires a fresh conflict review after a repeated latest read fails with KNOWLEDGE_ACCESS_REVOKED 1`] = `"修改文档保存位置知识库 / 知识库首页名称正文My unsaved changes所选知识库已失去访问权限，请刷新并重新选择。 (KNOWLEDGE_ACCESS_REVOKED)当前草稿已保留。请对照最新内容调整草稿，确认后再保存。读取最新版本取消保存"`;

