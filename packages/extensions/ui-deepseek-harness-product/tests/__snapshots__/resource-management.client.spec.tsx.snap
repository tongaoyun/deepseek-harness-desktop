exports[`removes a confirmed deletion from the catalog and prevents repeating it after device cleanup fails 1`] = `"The connector was deleted, but device connections or private settings could not be fully cleared. Restart the app and refresh to confirm. Do not delete it again. (CONNECTOR_DELETE_CLEANUP_FAILED)"`;

