exports[`explains an unavailable library endpoint and permits retry after a server update (METHOD_NOT_ALLOWED) 1`] = `
<div
  aria-label="编辑知识库"
  aria-modal="true"
  class="_dialog_fd3e65 _knowledgeBaseEditorModal_18bb7e"
  role="dialog"
  tabindex="-1"
>
  <div
    class="_content_fd3e65"
  >
    <div
      class="_header_fd3e65"
    >
      <h2
        class="_title_fd3e65"
      >
        编辑知识库
      </h2>
      <button
        aria-label="关闭"
        class="_close_fd3e65"
        data-dsh-automatic-focus=""
        type="button"
      >
        <svg
          aria-hidden="true"
          data-icon="dsw-icon-close-outline-regular"
          height="14"
          width="14"
        >
          <use
            href="#dsw-icon-close-outline-regular"
          />
        </svg>
      </button>
    </div>
    <div
      class="_body_fd3e65"
    >
      <form
        aria-label="编辑知识库"
        tabindex="-1"
      >
        <div
          class="_knowledgeSelectionError_18bb7e"
        >
          <p
            class="_catalogError_18bb7e"
            role="alert"
          >
            当前服务端尚未提供此功能，请更新服务端后重试。 (METHOD_NOT_ALLOWED)
          </p>
          <button
            aria-busy="false"
            aria-disabled="false"
            class="_button_4d2f85 _outline_4d2f85 _sm_4d2f85"
            type="button"
          >
            重试
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
`;

