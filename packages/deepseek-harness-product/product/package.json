{
  "name": "@deepseek-harness/product",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./bridge": {
      "types": "./lib/types/bridge.d.ts",
      "default": "./lib/bridge.js"
    },
    "./dingtalk-auth": {
      "types": "./lib/types/dingtalk-auth.d.ts",
      "default": "./lib/dingtalk-auth.js"
    },
    "./errors": {
      "types": "./lib/types/errors.d.ts",
      "default": "./lib/errors.js"
    },
    "./catalog-manager": {
      "types": "./lib/types/catalog-manager.d.ts",
      "default": "./lib/catalog-manager.js"
    },
    "./catalog": {
      "types": "./lib/types/catalog.d.ts",
      "default": "./lib/catalog.js"
    },
    "./connector-draft": {
      "types": "./lib/types/connector-draft.d.ts",
      "default": "./lib/connector-draft.js"
    },
    "./company-content": {
      "types": "./lib/types/company-content.d.ts",
      "default": "./lib/company-content.js"
    },
    "./company-team": {
      "types": "./lib/types/company-team.d.ts",
      "default": "./lib/company-team.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --config vitest.config.ts"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts"
  ],
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
