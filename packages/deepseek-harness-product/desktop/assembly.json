{
  "runtimePackages": [
    "@deepseek-harness/product-desktop"
  ],
  "builderConfig": "../../../apps/product-desktop/electron-builder.config.mjs",
  "buildSteps": [
    [
      "run",
      "build:native-product"
    ]
  ],
  "packageDirectories": [
    ".",
    "../runtime",
    "../product",
    "../../extensions/ui-deepseek-harness-product"
  ],
  "icons": {
    "macos": "resources/icon-macos.png",
    "windows": "resources/icon-windows.png",
    "tray": "resources/tray-windows.ico",
    "development": "resources/icon-macos.icns"
  },
  "resources": [
    {
      "from": "desktop-extension.json",
      "to": "desktop-extension.json"
    },
    {
      "from": "resources/product.json",
      "to": "deepseek-harness/product.json"
    },
    {
      "from": "../../../native/deepseek-harness/target/release/deepseek-harness-native",
      "to": "native/deepseek-harness-native",
      "platform": "darwin"
    },
    {
      "from": "../../../native/deepseek-harness/target/release/deepseek-harness-native.exe",
      "to": "native/deepseek-harness-native.exe",
      "platform": "win32"
    }
  ]
}
