{
  "name": "@deepseek-harness/product-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "files": ["lib", "resources", "assembly.json", "desktop-extension.json"],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./*": {
      "types": "./lib/types/*.d.ts",
      "default": "./lib/*.js"
    },
    "./assembly.json": "./assembly.json",
    "./desktop-extension.json": "./desktop-extension.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "zod": "^4.4.3",
    "tar": "^7.5.0",
    "yauzl": "^3.2.0",
    "@deepseek-harness/product": "workspace:*",
    "@deepseek-harness/product-runtime": "workspace:*",
    "@deepseek-harness/product-ui": "workspace:*"
  },
  "devDependencies": {
    "@types/yauzl": "^2.10.3",
    "@types/node": "^22.20.0",
    "electron": "^44.0.0"
  }
}
