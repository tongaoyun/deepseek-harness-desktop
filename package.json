{
  "name": "@xiaoyin/desktop",
  "version": "0.1.71",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:ui && pnpm --dir harness-host build",
    "build:ui": "tsc -b && vite build",
    "test": "vitest run && pnpm test:scripts && pnpm --dir harness-host test",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "typecheck": "tsc -b --pretty false && pnpm --dir harness-host typecheck",
    "lint": "oxlint --deny-warnings src harness-host/src scripts harness-host/scripts",
    "check": "pnpm check:web && cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "check:web": "pnpm verify:version && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm acceptance:harness-runtime && pnpm acceptance:harness-contracts && pnpm acceptance:tool-policy && pnpm acceptance:session-query",
    "verify:version": "node scripts/verify-version-consistency.mjs",
    "harness:prepare:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-harness-runtime.ps1",
    "harness:prepare:macos": "bash scripts/prepare-harness-runtime-macos.sh",
    "smoke:macos": "bash scripts/smoke-test-macos-bundle.sh",
    "tauri:build:macos": "bash scripts/build-macos.sh",
    "acceptance:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/acceptance-windows.ps1",
    "evaluation:list": "node harness-host/scripts/evaluate-work-tasks.mjs --list",
    "evaluation:run": "node harness-host/scripts/evaluate-work-tasks.mjs",
    "acceptance:harness-runtime": "node scripts/check-harness-runtime.mjs",
    "acceptance:harness-contracts": "node harness-host/scripts/acceptance-session-recovery.mjs && node harness-host/scripts/acceptance-long-task.mjs && node harness-host/scripts/acceptance-reasoning-effort.mjs && node harness-host/scripts/acceptance-skill-loading.mjs && node harness-host/scripts/acceptance-skill-tools.mjs && node harness-host/scripts/acceptance-task-outcomes.mjs && node harness-host/scripts/acceptance-session-continuity.mjs",
    "acceptance:session-query": "node harness-host/scripts/acceptance-session-query-concurrency.mjs",
    "acceptance:work-buddy": "node scripts/acceptance-work-buddy.mjs",
    "acceptance:tool-policy": "node harness-host/scripts/acceptance-model-tool-policy.mjs",
    "tauri": "node scripts/run-tauri.mjs",
    "tauri:dev": "node scripts/run-tauri.mjs dev",
    "tauri:dev:local": "node scripts/dev-local.mjs",
    "tauri:build": "node scripts/run-tauri.mjs build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "croner": "10.0.1",
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "0.468.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.10.13",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "28.1.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
