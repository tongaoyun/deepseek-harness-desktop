{
  "name": "@xiaoyin/desktop",
  "version": "0.1.31",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:ui && pnpm --dir harness-host build",
    "build:ui": "tsc -b && vite build",
    "test": "vitest run && pnpm --dir harness-host test",
    "typecheck": "tsc -b --pretty false && pnpm --dir harness-host typecheck",
    "lint": "oxlint --deny-warnings src harness-host/src",
    "check": "pnpm verify:version && pnpm lint && pnpm typecheck && pnpm test && pnpm build && cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --all-targets",
    "verify:version": "node scripts/verify-version-consistency.mjs",
    "harness:prepare:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-harness-runtime.ps1",
    "harness:prepare:macos": "bash scripts/prepare-harness-runtime-macos.sh",
    "smoke:macos": "bash scripts/smoke-test-macos-bundle.sh",
    "tauri:build:macos": "bash scripts/build-macos.sh",
    "acceptance:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/acceptance-windows.ps1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "0.468.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.10.13",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "28.1.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
