index e878c9db197bc62497cd2d8bc77bd45609d8fab2..5035cb9fac13042b0c5008954507a348aab94ead 100644
--- a/.gitattributes
+++ b/.gitattributes
@@ -8,8 +8,16 @@
 
 *.pdf binary
 
+# Unified diffs preserve context prefixes, including blank lines and Makefile tabs.
+# verify:upstream checks their exact bytes; authored source retains whitespace checks.
+scripts/upstream-patches/*.patch -whitespace
+
 # The persistence catalog is the readable projection of these generated schemas.
 docs/persistence-schema.json linguist-generated=true
 docs/persistence-changes/*.schema.json linguist-generated=true
 docs/persistence-changes/releases/*.schema.json linguist-generated=true
 docs/persistence-changes/historical-formats/*.schema.json linguist-generated=true
+
+# Imported community documents retain upstream Markdown hard breaks and ASCII separators.
+# This applies only to the fixed data payload; plugin source keeps normal whitespace checks.
+vendor/product-expert-fixtures/** -whitespace conflict-marker-size=128
