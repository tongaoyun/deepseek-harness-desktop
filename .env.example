VITE_CONTROL_PLANE_BASE_URL=http://127.0.0.1:8080

# Harness development only. Production credentials are provisioned per employee
# and stored in the operating-system keychain.
DEEPSEEK_BASE_URL=http://192.168.2.67:32000/v1
DEEPSEEK_API_KEY=set-an-employee-litellm-virtual-key
DSH_MODEL=deepseek-v4-flash
DSH_SESSION_ROOT=./.xiaoyin/sessions

# Harness Host development overrides. Production builds bundle the Node runtime
# and Harness Host entry instead of relying on global Node.
XIAOYIN_HARNESS_NODE=node
XIAOYIN_HARNESS_HOST_ENTRY=./harness-host/dist/index.js
XIAOYIN_HARNESS_CORDIS_CONFIG=./harness-host/runtime/cordis.yml

# Native ERP/DingTalk login overrides. Values must match the enterprise login
# application and the protected SSO exchange route.
XIAOYIN_ERP_LOGIN_URL=http://www.instudio.me:6206/eshop/manager/login.jsp
XIAOYIN_ERP_EXCHANGE_URL=http://www.instudio.me:6206/apisix/xiaoyin-sso/api/auth/exchange
XIAOYIN_ERP_COOKIE_URL=http://www.instudio.me:6206/
XIAOYIN_ERP_DINGTALK_APP_ID=set-the-enterprise-dingtalk-app-id
XIAOYIN_ERP_DINGTALK_CALLBACK_URL=set-the-registered-erp-callback-url
